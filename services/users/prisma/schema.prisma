generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  role         Role     @default(BUYER)
  avatar       String?
  bio          String?
  phone        String?
  city         String?
  cityCode     Int?
  districtCode Int?
  acceptingJobs Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  serviceAreas    ServiceArea[]
  userServices    UserService[]
  servicePrices   ServicePrice[]
  passwordResets  PasswordReset[]
  weeklyHours     WeeklyHours[]
  timeOff         TimeOff[]
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model ServiceArea {
  id           String @id @default(cuid())
  userId       String
  districtCode Int
  districtName String
  cityCode     Int?
  cityName     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, districtCode, cityCode])
  @@index([userId])
  @@index([districtCode])
  @@index([cityCode])
}

model UserService {
  id          String @id @default(cuid())
  userId      String
  serviceSlug String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceSlug])
  @@index([userId])
  @@index([serviceSlug])
}

model ServicePrice {
  id          String   @id @default(cuid())
  userId      String
  serviceSlug String
  price       Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceSlug])
  @@index([userId])
}

model WeeklyHours {
  id        String @id @default(cuid())
  userId    String
  dayOfWeek Int
  startMin  Int
  endMin    Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
  @@index([userId])
}

model TimeOff {
  id     String  @id @default(cuid())
  userId String
  date   String
  note   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}
