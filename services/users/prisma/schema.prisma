generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  role         Role     @default(BUYER)
  avatar       String?
  bio          String?
  phone        String?
  city         String?
  cityCode     Int?
  districtCode Int?
  emailVerified  Boolean  @default(false)
  acceptingJobs Boolean  @default(true)
  payoutBankAccount  String?
  payoutBankBranch   String?
  payoutAccountNumber String?
  notifyWhatsapp   Boolean @default(true)
  notifySms        Boolean @default(false)
  notifyEmail      Boolean @default(true)
  marketingConsent Boolean @default(false)
  marketingConsentAt DateTime?
  osekType       String?
  osekNumber     String?
  legalName      String?
  businessAddress String?
  suspendedAt   DateTime?
  suspendReason String?
  phoneVerified    Boolean  @default(false)
  phoneVerifiedAt  DateTime?
  identityStatus   String   @default("NONE")
  identityPhoto    String?
  identityReviewedAt DateTime?
  identityReviewedBy String?
  licenseStatus    String?
  licensePhoto     String?
  licenseType      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  serviceAreas        ServiceArea[]
  userServices        UserService[]
  servicePrices       ServicePrice[]
  passwordResets      PasswordReset[]
  emailVerifications  EmailVerification[]
  weeklyHours         WeeklyHours[]
  timeOff             TimeOff[]
  notifications       Notification[]
  phoneOtps           PhoneOtp[]
  savedAddresses      SavedAddress[]
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model ServiceArea {
  id           String @id @default(cuid())
  userId       String
  districtCode Int
  districtName String
  cityCode     Int?
  cityName     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, districtCode, cityCode])
  @@index([userId])
  @@index([districtCode])
  @@index([cityCode])
}

model UserService {
  id          String  @id @default(cuid())
  userId      String
  serviceSlug String
  alertsMuted Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceSlug])
  @@index([userId])
  @@index([serviceSlug])
}

/// In-app alerts. `type` is `NEW_NEARBY_REQUEST` for matched jobs; WhatsApp send is issue #52.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  href      String
  entityId  String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, entityId])
  @@index([userId, createdAt])
}

model ServicePrice {
  id                     String   @id @default(cuid())
  userId                 String
  serviceSlug            String
  price                  Float
  materialsEstimate      Float?
  buyerSuppliesMaterials Boolean  @default(true)
  description            String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceSlug])
  @@index([userId])
}

model WeeklyHours {
  id        String @id @default(cuid())
  userId    String
  dayOfWeek Int
  startMin  Int
  endMin    Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
  @@index([userId])
}

model TimeOff {
  id     String  @id @default(cuid())
  userId String
  date   String
  note   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model SavedAddress {
  id           String   @id @default(cuid())
  userId       String
  label        String
  cityCode     Int?
  cityName     String?
  districtCode Int?
  districtName String?
  street       String?
  floor        String?
  accessNotes  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// CBS localities for pickers. Request path reads this table only; data.gov.il is a daily background refresh.
model City {
  code         Int      @id
  name         String
  districtCode Int
  districtName String
  regionName   String   @default("")
  updatedAt    DateTime @updatedAt

  @@index([districtCode])
}

/// Singleton (id=1). fetchedAt is the last successful government pull; null means snapshot-only.
model CityCatalog {
  id        Int       @id @default(1)
  source    String    @default("snapshot")
  fetchedAt DateTime?
}

/// Audit log for WhatsApp / SMS / email dispatch attempts.
model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  channel   String   // "whatsapp", "sms", "email"
  template  String
  status    String   // "sent", "failed", "skipped"
  error     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model PhoneOtp {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phone, code])
}
