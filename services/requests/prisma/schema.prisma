generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum PreferredWindow {
  MORNING
  AFTERNOON
  WEEKEND
}

model ServiceRequest {
  id           String        @id @default(cuid())
  title        String
  description  String
  serviceSlug  String?
  buyerId      String        // cross-service ref to users-service
  districtCode Int?
  districtName String?
  cityCode     Int?
  cityName     String?
  street             String?
  floor              String?
  preferredWindow    PreferredWindow?
  photos             String[]        @default([])
  status             RequestStatus @default(OPEN)
  unlisted           Boolean       @default(false)
  slotStart          DateTime?
  slotEnd            DateTime?
  selectedResponseId String?
  orderId            String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  responses RequestResponse[]

  @@index([buyerId])
  @@index([status])
  @@index([districtCode])
  @@index([status, unlisted, createdAt])
}

model RequestResponse {
  id                     String   @id @default(cuid())
  requestId              String
  sellerId               String   // cross-service ref to users-service
  message                String
  proposedPrice          Float?
  laborPrice             Float?
  materialsEstimate      Float?
  buyerSuppliesMaterials Boolean  @default(true)
  selected               Boolean  @default(false)
  createdAt              DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, sellerId])
  @@index([requestId])
  @@index([sellerId])
}

model AnalyticsEvent {
  id            String   @id @default(uuid()) @db.Uuid
  eventName     String   @map("event_name")
  eventCategory String   @map("event_category")
  actorId       String?  @map("actor_id") @db.Uuid
  actorRole     String?  @map("actor_role")
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  properties    Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("analytics_events")
  @@index([eventName], map: "idx_events_name")
  @@index([eventCategory], map: "idx_events_category")
  @@index([actorId], map: "idx_events_actor")
  @@index([createdAt], map: "idx_events_created")
}
