generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum PreferredWindow {
  MORNING
  AFTERNOON
  WEEKEND
}

model ServiceRequest {
  id           String        @id @default(cuid())
  title        String
  description  String
  serviceSlug  String?
  buyerId      String        // cross-service ref to users-service
  districtCode Int?
  districtName String?
  cityCode     Int?
  cityName     String?
  street             String?
  floor              String?
  preferredWindow    PreferredWindow?
  photos             String[]        @default([])
  status             RequestStatus @default(OPEN)
  unlisted           Boolean       @default(false)
  slotStart          DateTime?
  slotEnd            DateTime?
  selectedResponseId String?
  orderId            String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  responses RequestResponse[]

  @@index([buyerId])
  @@index([status])
  @@index([districtCode])
  @@index([status, unlisted, createdAt])
}

model RequestResponse {
  id                     String   @id @default(cuid())
  requestId              String
  sellerId               String   // cross-service ref to users-service
  message                String
  proposedPrice          Float?
  laborPrice             Float?
  materialsEstimate      Float?
  buyerSuppliesMaterials Boolean  @default(true)
  selected               Boolean  @default(false)
  createdAt              DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, sellerId])
  @@index([requestId])
  @@index([sellerId])
}
