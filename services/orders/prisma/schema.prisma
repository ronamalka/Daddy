generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
}

enum GigTier {
  BASIC
  STANDARD
  PREMIUM
}

enum JobType {
  GIG
  LOCAL_REQUEST
}

enum DisputeReason {
  NO_SHOW
  DAMAGE
  DIFFERENT_PRICE
  QUALITY
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_RELEASE
  RESOLVED_REFUND
  RESOLVED_SPLIT
  CLOSED
}

enum PaymentAction {
  RELEASE
  REFUND
  SPLIT
}

enum CancellationFeeStatus {
  NONE
  OWED
  COLLECTED
  WAIVED
}

model Order {
  id        String      @id @default(cuid())
  jobType   JobType     @default(GIG)
  gigId     String?     // null for local jobs
  requestId String?
  title     String?
  buyerId   String      // cross-service ref to users-service
  sellerId  String      // cross-service ref to users-service
  tier                     GigTier?
  price                    Float
  laborPrice               Float?
  materialsEstimate        Float?
  buyerSuppliesMaterials   Boolean      @default(true)
  pendingMaterialsEstimate Float?
  materialsUpdatedAt       DateTime?
  materialsAcknowledgedAt  DateTime?
  status                   OrderStatus  @default(PENDING)
  dueDate   DateTime?
  slotStart DateTime?
  slotEnd   DateTime?
  cancelledAt           DateTime?
  cancelledById         String?
  cancellationFee       Float                 @default(0)
  cancellationFeeStatus CancellationFeeStatus @default(NONE)
  deliveryPhotos        String[]              @default([])
  deliveryNote          String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  requirements OrderRequirement[]
  disputes     Dispute[]
  invoice      Invoice?

  @@index([buyerId])
  @@index([sellerId])
  @@index([gigId])
  @@index([requestId])
  @@index([sellerId, slotStart])
}

model Invoice {
  id               String   @id @default(cuid())
  orderId          String   @unique
  invoiceNumber    Int      @unique @default(autoincrement())
  sellerLegalName  String
  sellerOsekNumber String?
  sellerOsekType   String   // "patur" or "murshe"
  sellerAddress    String?
  buyerName        String
  serviceDescription String
  laborAmount      Float
  materialsAmount  Float?
  subtotal         Float
  vatRate          Float    @default(0)
  vatAmount        Float    @default(0)
  total            Float
  issuedAt         DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model OrderRequirement {
  id            String @id @default(cuid())
  orderId       String
  requirementId String // cross-service ref to gigs-service GigRequirement
  answer        String

  order Order @relation(fields: [orderId], references: [id])

  @@unique([orderId, requirementId])
}

model Dispute {
  id               String         @id @default(cuid())
  orderId          String
  openerId         String
  reason           DisputeReason
  description      String
  photos           String[]
  status           DisputeStatus  @default(OPEN)
  resolution       String?
  paymentAction    PaymentAction?
  splitBuyerAmount Float?
  resolvedAt       DateTime?
  resolvedBy       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([openerId])
  @@index([status])
}

