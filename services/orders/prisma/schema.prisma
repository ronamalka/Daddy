generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  ON_THE_WAY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum GigTier {
  BASIC
  STANDARD
  PREMIUM
}

enum JobType {
  GIG
  LOCAL_REQUEST
}

enum DisputeReason {
  NO_SHOW
  DAMAGE
  DIFFERENT_PRICE
  QUALITY
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_RELEASE
  RESOLVED_REFUND
  RESOLVED_SPLIT
  CLOSED
}

enum PaymentAction {
  RELEASE
  REFUND
  SPLIT
}

enum CancellationFeeStatus {
  NONE
  OWED
  COLLECTED
  WAIVED
}

enum PaymentStatus {
  UNPAID
  PENDING
  HELD
  RELEASED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum PaymentMethod {
  CARD
  BIT
  CASH
}

enum MaintenancePlanStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum MaintenanceVisitStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  MISSED
  CANCELLED
}

model Order {
  id        String      @id @default(cuid())
  jobType   JobType     @default(GIG)
  gigId     String?     // null for local jobs
  requestId String?
  title     String?
  buyerId   String      // cross-service ref to users-service
  sellerId  String      // cross-service ref to users-service
  tier                     GigTier?
  price                    Float
  laborPrice               Float?
  materialsEstimate        Float?
  buyerSuppliesMaterials   Boolean      @default(true)
  pendingMaterialsEstimate Float?
  materialsUpdatedAt       DateTime?
  materialsAcknowledgedAt  DateTime?
  status                   OrderStatus  @default(PENDING)
  dueDate   DateTime?
  slotStart DateTime?
  slotEnd   DateTime?
  cancelledAt           DateTime?
  cancelledById         String?
  cancellationFee       Float                 @default(0)
  cancellationFeeStatus CancellationFeeStatus @default(NONE)
  onTheWayAt            DateTime?
  onTheWayEta           String?
  deliveryPhotos        String[]              @default([])
  deliveryNote          String?
  commissionRate       Float?
  commissionAmount     Float?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  requirements   OrderRequirement[]
  disputes       Dispute[]
  payments       Payment[]
  invoice        Invoice?
  warrantyClaims WarrantyClaim[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([gigId])
  @@index([requestId])
  @@index([sellerId, slotStart])
}

model Invoice {
  id               String   @id @default(cuid())
  orderId          String   @unique
  invoiceNumber    Int      @unique @default(autoincrement())
  sellerLegalName  String
  sellerOsekNumber String?
  sellerOsekType   String   // "patur" or "murshe"
  sellerAddress    String?
  buyerName        String
  serviceDescription String
  laborAmount      Float
  materialsAmount  Float?
  subtotal         Float
  vatRate          Float    @default(0)
  vatAmount        Float    @default(0)
  total            Float
  issuedAt         DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model OrderRequirement {
  id            String @id @default(cuid())
  orderId       String
  requirementId String // cross-service ref to gigs-service GigRequirement
  answer        String

  order Order @relation(fields: [orderId], references: [id])

  @@unique([orderId, requirementId])
}

model Dispute {
  id               String         @id @default(cuid())
  orderId          String
  openerId         String
  reason           DisputeReason
  description      String
  photos           String[]
  status           DisputeStatus  @default(OPEN)
  resolution       String?
  paymentAction    PaymentAction?
  splitBuyerAmount Float?
  resolvedAt       DateTime?
  resolvedBy       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([openerId])
  @@index([status])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  amount          Float
  currency        String        @default("ILS")
  method          PaymentMethod
  status          PaymentStatus @default(UNPAID)
  gatewayId       String?
  gatewayResponse Json?
  heldAt          DateTime?
  releasedAt      DateTime?
  refundedAt      DateTime?
  refundAmount    Float?
  failureReason   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([gatewayId])
  @@index([status])
}

model MaintenancePlan {
  id           String                @id @default(cuid())
  buyerId      String
  sellerId     String?
  planType     String                @default("BASIC")
  priceMonthly Float                 @default(99)
  status       MaintenancePlanStatus @default(ACTIVE)
  startedAt    DateTime              @default(now())
  nextVisitAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  visits MaintenanceVisit[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model MaintenanceVisit {
  id          String                 @id @default(cuid())
  planId      String
  scheduledAt DateTime
  completedAt DateTime?
  status      MaintenanceVisitStatus @default(SCHEDULED)
  report      String?
  photos      String[]               @default([])
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  plan MaintenancePlan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([scheduledAt])
  @@index([status])
}

enum WarrantyStatus {
  OPEN
  UNDER_REVIEW
  APPROVED_RESEND
  APPROVED_REFUND
  REJECTED
  CLOSED
}

model WarrantyClaim {
  id          String         @id @default(cuid())
  orderId     String
  buyerId     String
  description String
  photos      String[]       @default([])
  status      WarrantyStatus @default(OPEN)
  resolution  String?
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([buyerId])
  @@index([status])
}

model AnalyticsEvent {
  id            String   @id @default(uuid()) @db.Uuid
  eventName     String   @map("event_name")
  eventCategory String   @map("event_category")
  actorId       String?  @map("actor_id") @db.Uuid
  actorRole     String?  @map("actor_role")
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  properties    Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("analytics_events")
  @@index([eventName], map: "idx_events_name")
  @@index([eventCategory], map: "idx_events_category")
  @@index([actorId], map: "idx_events_actor")
  @@index([createdAt], map: "idx_events_created")
}

