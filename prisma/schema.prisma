generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum GigTier {
  BASIC
  STANDARD
  PREMIUM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  role         Role     @default(BUYER)
  avatar       String?
  bio          String?
  phone        String?
  city         String?
  cityCode      Int?
  districtCode  Int?
  acceptingJobs Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  gigs             Gig[]
  ordersAsBuyer    Order[]       @relation("BuyerOrders")
  ordersAsSeller   Order[]       @relation("SellerOrders")
  reviews          Review[]
  sentMessages     Message[]     @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
  favorites        Favorite[]
  serviceAreas     ServiceArea[]
  userServices     UserService[]
  servicePrices    ServicePrice[]
  serviceRequests  ServiceRequest[]  @relation("BuyerRequests")
  requestResponses RequestResponse[] @relation("SellerResponses")
  passwordResets   PasswordReset[]
  reviewFlags      ReviewFlag[]
  weeklyHours      WeeklyHours[]
  timeOff          TimeOff[]
}

model WeeklyHours {
  id        String @id @default(cuid())
  userId    String
  dayOfWeek Int
  startMin  Int
  endMin    Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
  @@index([userId])
}

model TimeOff {
  id     String  @id @default(cuid())
  userId String
  date   String
  note   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique
  gigs Gig[]
}

model ServiceArea {
  id           String @id @default(cuid())
  userId       String
  districtCode Int
  districtName String
  cityCode     Int?
  cityName     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, districtCode, cityCode])
  @@index([userId])
  @@index([districtCode])
  @@index([cityCode])
}

model UserService {
  id          String @id @default(cuid())
  userId      String
  serviceSlug String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceSlug])
  @@index([userId])
  @@index([serviceSlug])
}

model ServiceRequest {
  id           String        @id @default(cuid())
  title        String
  description  String
  serviceSlug  String?
  buyerId      String
  districtCode Int?
  districtName String?
  cityCode     Int?
  cityName     String?
  status       RequestStatus @default(OPEN)
  slotStart    DateTime?
  slotEnd      DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  buyer     User              @relation("BuyerRequests", fields: [buyerId], references: [id])
  responses RequestResponse[]

  @@index([buyerId])
  @@index([status])
  @@index([districtCode])
}

model RequestResponse {
  id            String   @id @default(cuid())
  requestId     String
  sellerId      String
  message       String
  proposedPrice Float?
  createdAt     DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  seller  User           @relation("SellerResponses", fields: [sellerId], references: [id])

  @@unique([requestId, sellerId])
  @@index([requestId])
  @@index([sellerId])
}

model Gig {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String?
  categoryId  String
  sellerId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  Category         @relation(fields: [categoryId], references: [id])
  seller    User             @relation(fields: [sellerId], references: [id])
  tiers     GigPricingTier[]
  orders    Order[]
  reviews   Review[]
  images    GigImage[]
  faqs      GigFaq[]
  favorites Favorite[]
  requirements GigRequirement[]

  @@index([categoryId])
  @@index([sellerId])
}

model GigPricingTier {
  id           String  @id @default(cuid())
  gigId        String
  tier         GigTier
  title        String
  description  String
  price        Float
  deliveryDays Int
  revisions    Int

  gig Gig @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@unique([gigId, tier])
}

model GigImage {
  id    String @id @default(cuid())
  gigId String
  url   String
  order Int    @default(0)

  gig Gig @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@index([gigId])
}

model GigFaq {
  id       String @id @default(cuid())
  gigId    String
  question String
  answer   String
  order    Int    @default(0)

  gig Gig @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@index([gigId])
}

model GigRequirement {
  id       String  @id @default(cuid())
  gigId    String
  question String
  required Boolean @default(true)
  order    Int     @default(0)

  gig     Gig               @relation(fields: [gigId], references: [id], onDelete: Cascade)
  answers OrderRequirement[]

  @@index([gigId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  gigId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  gig  Gig  @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@unique([userId, gigId])
  @@index([userId])
}

model Order {
  id        String      @id @default(cuid())
  gigId     String
  buyerId   String
  sellerId  String
  tier      GigTier
  price     Float
  status    OrderStatus @default(PENDING)
  dueDate   DateTime?
  slotStart DateTime?
  slotEnd   DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  gig          Gig                @relation(fields: [gigId], references: [id])
  buyer        User               @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller       User               @relation("SellerOrders", fields: [sellerId], references: [id])
  messages     Message[]
  review       Review?
  requirements OrderRequirement[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([gigId])
  @@index([sellerId, slotStart])
}

model OrderRequirement {
  id            String @id @default(cuid())
  orderId       String
  requirementId String
  answer        String

  order       Order          @relation(fields: [orderId], references: [id])
  requirement GigRequirement @relation(fields: [requirementId], references: [id])

  @@unique([orderId, requirementId])
}

model Review {
  id                  String    @id @default(cuid())
  rating              Int
  comment             String
  ratingAttitude      Int?
  ratingTimeliness    Int?
  ratingPrice         Int?
  ratingQuality       Int?
  communicationRating Int?
  qualityRating       Int?
  timelinessRating    Int?
  sellerResponse      String?
  sellerResponseAt    DateTime?
  orderId             String    @unique
  gigId               String
  userId              String
  createdAt           DateTime  @default(now())

  order Order        @relation(fields: [orderId], references: [id])
  gig   Gig          @relation(fields: [gigId], references: [id])
  user  User         @relation(fields: [userId], references: [id])
  flags ReviewFlag[]
}

model ReviewFlag {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  reason    String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([reviewId, userId])
  @@index([reviewId])
}

model ServicePrice {
  id          String @id @default(cuid())
  userId      String
  serviceSlug String
  price       Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceSlug])
  @@index([userId])
}

model Message {
  id         String   @id @default(cuid())
  content    String
  attachment String?
  orderId    String?
  senderId   String
  receiverId String
  readAt     DateTime?
  createdAt  DateTime @default(now())

  order    Order? @relation(fields: [orderId], references: [id])
  sender   User   @relation("SentMessages", fields: [senderId], references: [id])
  receiver User   @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([orderId])
  @@index([senderId])
  @@index([receiverId])
}
