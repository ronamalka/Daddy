# Build stages run NATIVELY on the host (ARM) for speed.
# Only the final runner stage and its deps are amd64.

FROM node:22-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build"
ENV AUTH_SECRET="build-time-placeholder-at-least-32-chars-long"
RUN npm run build

# Install amd64 node_modules for prisma CLI engines (db push needs schema-engine)
FROM --platform=linux/amd64 node:22-alpine AS deps-amd64
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY package.json package-lock.json* ./
COPY prisma ./prisma
RUN npm ci && npx prisma generate --no-hints

# Final stage: amd64 for OpenShift
FROM --platform=linux/amd64 node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=builder /app/public ./public
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/src/generated ./src/generated

RUN mkdir .next

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# Use amd64 node_modules (has correct engine binaries for the target platform)
COPY --from=deps-amd64 /app/node_modules ./node_modules

# OpenShift runs containers with a random UID in gid 0 (root group).
RUN chgrp -R 0 /app && chmod -R g=u /app

USER 1001

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
